VITE_AUTH_MODE=local
# No Supabase connection is required for the default client demo.
# Optional cloud mode requires VITE_AUTH_MODE=cloud and these public settings:
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Optional: expose a clearly labeled local demo entry on the production login screen.
# Leave false for a login-only production workspace.
VITE_ENABLE_DEMO=false
